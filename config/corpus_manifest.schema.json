{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://takhrij.invalid/schema/corpus-manifest-v1.json",
  "title": "TAKHRIJ corpus manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release",
    "release_date",
    "release_uri",
    "release_doi",
    "content_kind",
    "license",
    "attribution",
    "approval",
    "source_root_env",
    "documents"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "release": { "type": "string", "minLength": 1 },
    "release_date": { "type": ["string", "null"] },
    "release_uri": { "type": "string", "minLength": 1 },
    "release_doi": { "type": ["string", "null"] },
    "content_kind": {
      "enum": ["synthetic_fixture", "approved_corpus"]
    },
    "license": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "uri"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "uri": { "type": "string", "minLength": 1 }
      }
    },
    "attribution": { "type": "string", "minLength": 1 },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reference"],
      "properties": {
        "status": { "type": "string", "minLength": 1 },
        "reference": { "type": "string", "minLength": 1 }
      }
    },
    "source_root_env": { "type": ["string", "null"] },
    "documents": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/document" }
    }
  },
  "$defs": {
    "nullableString": { "type": ["string", "null"] },
    "ahYear": {
      "oneOf": [
        { "type": "integer", "minimum": 1, "maximum": 1600 },
        { "type": "null" }
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metadata_source_uri",
        "author_death_year_ah",
        "author_date_source_uri",
        "composition_date_ah",
        "composition_date_source_uri",
        "edition_citation",
        "edition_date",
        "edition_source_uri",
        "witness_description",
        "witness_date",
        "witness_source_uri",
        "quality_status",
        "quality_notes"
      ],
      "properties": {
        "metadata_source_uri": { "type": "string", "minLength": 1 },
        "author_death_year_ah": { "$ref": "#/$defs/ahYear" },
        "author_date_source_uri": { "$ref": "#/$defs/nullableString" },
        "composition_date_ah": { "$ref": "#/$defs/ahYear" },
        "composition_date_source_uri": { "$ref": "#/$defs/nullableString" },
        "edition_citation": { "$ref": "#/$defs/nullableString" },
        "edition_date": { "$ref": "#/$defs/nullableString" },
        "edition_source_uri": { "$ref": "#/$defs/nullableString" },
        "witness_description": { "$ref": "#/$defs/nullableString" },
        "witness_date": { "$ref": "#/$defs/nullableString" },
        "witness_source_uri": { "$ref": "#/$defs/nullableString" },
        "quality_status": { "type": "string", "minLength": 1 },
        "quality_notes": { "type": "string", "minLength": 1 }
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "doc_id",
        "work_id",
        "title",
        "author",
        "path",
        "source_uri",
        "source_sha256",
        "source_format",
        "language",
        "calendar",
        "selection_reason",
        "provenance"
      ],
      "properties": {
        "doc_id": { "type": "string", "minLength": 1 },
        "work_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "author": { "type": "string", "minLength": 1 },
        "path": { "type": "string", "minLength": 1 },
        "source_uri": { "type": "string", "minLength": 1 },
        "source_sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "source_format": { "enum": ["plain_text", "openiti_mARkdown"] },
        "language": { "const": "ara" },
        "calendar": { "const": "AH" },
        "selection_reason": { "type": "string", "minLength": 1 },
        "provenance": { "$ref": "#/$defs/provenance" }
      }
    }
  }
}
