APP_ENV=development
GOOGLE_CLOUD_PROJECT=replace-me
GOOGLE_CLOUD_LOCATION=global
GOOGLE_GENAI_USE_ENTERPRISE=True
GEMINI_MODEL_ID=gemini-3.5-flash
FIRESTORE_COLLECTION=claims
PUBSUB_TOPIC=takhrij-claims
PUBSUB_AUDIENCE=https://replace-me.run.app/worker
PUBSUB_SERVICE_ACCOUNT=takhrij-push@replace-me.iam.gserviceaccount.com
CORPUS_DB_PATH=data/takhrij.db
CORPUS_RELEASE=REPLACE_WITH_VERIFIED_OPENITI_RELEASE
CORPUS_BOOK_IDS=fixture-early,fixture-markup,fixture-late
LEASE_SECONDS=900
MAX_MATCHES=200
MAX_VARIANTS=64
MAX_ACTIVE_JOBS=1
MAX_JOBS_PER_DAY=20
MAX_DELIVERY_ATTEMPTS=5
LOCAL_INLINE_WORKER=false
REDACT_CORPUS_TEXT=false
